# Copy to .env.local and fill in. Never commit real values.

# Required for the estimate comparison tool.
ANTHROPIC_API_KEY=
# Optional: override the model used for extraction and matching.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: enables rate limiting and usage logging. Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; used to hash visitor IPs.
IP_HASH_SALT=
FREE_RUNS_PER_DAY=3

# Booking page, mailto: or tel: link for the "Talk to an expert" button. Hidden when empty.
NEXT_PUBLIC_EXPERT_URL=
